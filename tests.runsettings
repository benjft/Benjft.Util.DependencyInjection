<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
            <ModulePaths>
                <Exclude>
                    <ModulePath>\.Tests</ModulePath>
                    <ModulePath>\.TestFixtures\.</ModulePath>
                </Exclude>
            </ModulePaths>
          <Format>lcov</Format>
          <IncludeTestAssembly>false</IncludeTestAssembly>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>