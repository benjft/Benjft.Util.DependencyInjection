<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <PackageId>Benjft.Util.DependencyInjection</PackageId>
        <Version>1.0.0</Version>
        <Authors>benjft</Authors>
        <Company>benjft</Company>
        <Description>Utility library for automatic dependency injection registration with attributes</Description>
        <PackageTags>dependency-injection;attributes;di;extensions</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
<!--        <PackageReadmeFile>README.md</PackageReadmeFile>-->
        <RepositoryUrl>https://github.com/benjft/Benjft.Util</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
        <PackageProjectUrl>https://github.com/benjft/Benjft.Util</PackageProjectUrl>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        
        <PackageId>Benjft.Util.DependencyInjection</PackageId>
        
        <LangVersion>default</LangVersion>
    </PropertyGroup>

    <ItemGroup>
      <InternalsVisibleTo Include="Benjft.Util.DependencyInjection.Tests" />
      <PackageReference Include="JetBrains.Annotations" Version="2025.2.2" />
      <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.1" />
    </ItemGroup>

</Project>
